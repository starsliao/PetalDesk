{
  "manifest_version": 3,
  "name": "飞花 - PetalDesk 浏览器增强",
  "version": "0.8.8",
  "description": "飞花 Chrome 浏览器增强，支持长截图、用户触发的密码填充、登录保存提示与关联 TOTP 填充。",
  "homepage_url": "https://starsliao.github.io/PetalDesk/chrome.html",
  "key": "",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "assets/icons/petaldesk-16.png",
    "32": "assets/icons/petaldesk-32.png",
    "48": "assets/icons/petaldesk-48.png",
    "96": "assets/icons/petaldesk-96.png",
    "128": "assets/icons/petaldesk-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/chromium-entry.js"
  },
  "action": {
    "default_title": "飞花密码管理",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/petaldesk-16.png",
      "32": "assets/icons/petaldesk-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/scroll-core.js",
        "shared/password-templates.js",
        "content/capture-session.js",
        "content/password-manager.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
