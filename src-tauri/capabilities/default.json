{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "飞花 - PetalDesk main, note, and desktop tool window permissions",
  "windows": ["main", "note-*", "timer", "reminder", "gantt", "mfa", "passwords", "screenshot-capture", "screenshot-long-control", "screenshot-long-outline", "screenshot-pin-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-max-size",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "opener:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
