{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.petaldesk.desktop",
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
